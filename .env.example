# Only needed for paid backends. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# fake (default, free), claude, openai or auto
LETTABLE_BACKEND=fake

# Voice (ElevenLabs). Speech-to-text and phone calls are off unless asked for.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# stt: off | fake | elevenlabs     calls: dry_run | elevenlabs
LETTABLE_STT=off
LETTABLE_CALLS=dry_run
# A phone you control, for the live demo call only
DEMO_CALL_NUMBER=
# Telephony for live calls. Only read by `python3 -m agent voice-setup --import-number +44...`, once;
# after that ElevenLabs dials through the imported Twilio number and only needs the three ELEVENLABS_* values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Only needed with consistency_check on (Jev, api.typesafe.ai). Never commit the real value.
TYPESAFE_API_KEY=
# Optional: defaults to jev-1.13.0 and https://api.typesafe.ai
TYPESAFE_MODEL=
TYPESAFE_BASE_URL=
